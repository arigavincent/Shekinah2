      paddingHorizontal: 16,
      paddingVertical: 14,
      color: theme.colors.text,
      fontSize: 15,
      fontWeight: '600',
    },
    bookCard: {
      backgroundColor: theme.colors.surface,
      borderRadius: theme.radius.lg,
      padding: layout.panelPadding,
      borderWidth: 1,
      borderColor: theme.colors.border,
      flexDirection: 'row',
      alignItems: 'center',
      gap: theme.spacing.md,
    },
    bookIconWrap: {
      width: 52,
      height: 52,
      borderRadius: 16,
      backgroundColor: 'rgba(227, 93, 106, 0.14)',
      alignItems: 'center',
      justifyContent: 'center',
    },
    bookCopy: {
      flex: 1,
    },
    bookTitle: {
      color: theme.colors.text,
      fontSize: 16,
      fontWeight: '800',
      marginBottom: 4,
    },
    bookSubtitle: {
      color: theme.colors.textMuted,
      fontSize: 14,
      fontWeight: '600',
    },
    bookActions: {
      flexDirection: 'row',
      alignItems: 'center',
      gap: theme.spacing.sm,
    },
    bookActionButton: {
      width: 34,
      height: 34,
      borderRadius: 12,
      alignItems: 'center',
      justifyContent: 'center',
    },
    emptyCard: {
      backgroundColor: theme.colors.surface,
      borderRadius: theme.radius.lg,
      padding: layout.panelPadding,
      borderWidth: 1,
      borderColor: theme.colors.border,
    },
    emptyTitle: {
      color: theme.colors.text,
      fontSize: 18,
      fontWeight: '800',
      marginBottom: 6,
    },
    emptyBody: {
      color: theme.colors.textSecondary,
      fontSize: 14,
      lineHeight: 20,
    },
    gridIntroTitle: {
      color: theme.colors.text,
      fontSize: 18,
      fontWeight: '800',
    },
    gridWrap: {
      flexDirection: 'row',
      flexWrap: 'wrap',
      gap: layout.gridGap,
    },
    numberCard: {
      height: layout.isCompact ? 82 : 90,
      borderRadius: theme.radius.lg,
      backgroundColor: theme.colors.surface,

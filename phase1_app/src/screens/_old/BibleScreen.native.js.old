    numberCardValue: {
      color: theme.colors.text,
      fontSize: 20,
      fontWeight: '900',
      marginBottom: 4,
    },
    numberCardValueActive: {
      color: theme.colors.accent,
    },
    numberCardLabel: {
      color: theme.colors.textMuted,
      fontSize: 12,
      fontWeight: '700',
    },
    numberCardLabelActive: {
      color: theme.colors.accent,
    },
    openWholeChapterButton: {
      flexDirection: 'row',
      alignItems: 'center',

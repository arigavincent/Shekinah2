    },
    modalTitle: {
      color: theme.colors.text,
      fontSize: 18,
      fontWeight: '800',
    },
    modalInput: {
      margin: layout.panelPadding,
      marginBottom: theme.spacing.sm,
      borderRadius: theme.radius.md,
      borderWidth: 1,
      borderColor: theme.colors.borderStrong,
      backgroundColor: theme.colors.surfaceMuted,

      color: theme.colors.text,
      fontSize: 18 * fontScale,
      lineHeight: 30 * fontScale,
      fontWeight: '600',
    },
    readerBottomNav: {
      flexDirection: 'row',
      gap: theme.spacing.md,
    },
    bottomNavButton: {
      flex: 1,
      backgroundColor: theme.colors.primaryStrong,
      borderRadius: theme.radius.lg,
      paddingVertical: 16,
      paddingHorizontal: 16,
      flexDirection: 'row',
      alignItems: 'center',
      justifyContent: 'center',
      gap: 8,

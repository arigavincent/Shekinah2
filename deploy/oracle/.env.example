# Copy to .env and fill in. Never commit .env.

# Web addresses (point each at this server in DNS; see README).
APP_DOMAIN=app.shekinahsonsglobal.org
MEDIA_DOMAIN=media.shekinahsonsglobal.org
HLS_DOMAIN=hls.shekinahsonsglobal.org
WEBRTC_DOMAIN=webrtc.shekinahsonsglobal.org
# Where cameras/OBS send video (RTMP has no HTTPS; any of the names above, or the IP).
LIVE_HOST=live.shekinahsonsglobal.org
# The server's public IP address (Oracle console → Instance → Public IP).
PUBLIC_IP=
# For HTTPS certificate notices.
ACME_EMAIL=

# Make each of these long and random:  openssl rand -hex 24
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=shekinah
STORAGE_SECRET_KEY=
LIVE_INTERNAL_SECRET=
STORAGE_BUCKET=shekinah-sermons

# Cloudflare R2 backup copy (R2 → Manage API tokens → Object Read & Write).
BACKUP_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=shekinah-backup
# Hour of the nightly backup, Nairobi time.
BACKUP_HOUR=2

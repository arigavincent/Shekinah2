# The app's own settings. Copy to app.env. Most values are the same as on
# Render today (Render dashboard → the service → Environment).

JWT_SECRET=
# Must be the SAME as on Render, or existing encrypted books/recordings can't be opened.
LIBRARY_ENCRYPTION_KEY=
MEDIA_PROVIDER=r2
MEDIA_REQUIRE_REMOTE_STORAGE=true
LIVE_REPLAY_CACHE_HOURS=24

# Push notifications (Firebase service account JSON on one line).
FCM_SERVICE_ACCOUNT_JSON=

# M-Pesa (Daraja).
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=Shekinah
MPESA_CALLBACK_URL=https://app.shekinahsonsglobal.org/api/v1/giving/mpesa/callback
MPESA_CALLBACK_TOKEN=

# Card payments (Flutterwave), optional.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_REDIRECT_URL=

# Email (password reset codes, receipts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Bible.
API_BIBLE_KEY=
BIBLE_BRAIN_KEY=

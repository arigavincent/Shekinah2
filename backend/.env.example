APP_ENV=development
HTTP_ADDR=:3000
DATABASE_URL=postgres://shekinah:shekinah@localhost:55432/shekinah?sslmode=disable
JWT_SECRET=dev-only-change-this-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary media storage.
# Leave empty locally to use uploads/media fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://shekinah-sons-backend.onrender.com/api/v1/giving/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=Shekinah

# Recording worker (ffmpeg required); default is relative to backend/.
LIVE_RECORDINGS_DIR=../.local/recordings
# Set false only for local tests that must not deliver external pushes.
NOTIFICATIONS_DELIVERY_ENABLED=true
# Random callback capability shared only with the M-Pesa provider.
MPESA_CALLBACK_TOKEN=
# Human narration: translation-id -> licensed fileset and attribution JSON.
BIBLE_BRAIN_KEY=
BIBLE_BRAIN_FILESETS={}

# Private resumable upload staging; mount durable storage here in production.
UPLOAD_STAGING_DIR=.local/upload-staging

# Browser WHIP publishing: reachable HTTPS origin in production, localhost for development.
LIVE_WHIP_URL=http://127.0.0.1:8889
# Set LIVE_WEBRTC_HOSTS in the root Compose environment to reachable media host IPs.

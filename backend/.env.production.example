# Fill real deployment values; operational provider credentials can be set in Admin Settings.
APP_ENV=production
HTTP_ADDR=:3000
DATABASE_URL=
# Persistent random secret, at least 32 characters. Preserve it for encrypted settings.
JWT_SECRET=
# The actual HTTPS dashboard origin, without a trailing slash.
ALLOWED_ORIGINS=
# Persistent base64-encoded 32-byte key; keep a separate backup.
LIBRARY_ENCRYPTION_KEY=

R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_SERMONS_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only public covers/images belong behind a public base URL.
R2_PUBLIC_BASE_URL=
R2_SERMONS_PUBLIC_BASE_URL=
MEDIA_PROVIDER=r2

# Durable writable storage; mount the recordings directory into MediaMTX too.
UPLOAD_STAGING_DIR=/var/lib/shekinah/upload-staging
LIVE_RECORDINGS_DIR=/var/lib/shekinah/recordings
# Actual client-reachable media origins. HTTPS for HLS/WHIP, RTMPS where configured.
LIVE_RTMP_URL=
LIVE_HLS_URL=
LIVE_WHIP_URL=
# Private control API; never expose port 9997 publicly.
LIVE_MEDIAMTX_API=http://127.0.0.1:9997
NOTIFICATIONS_DELIVERY_ENABLED=false

# Prefer Admin Settings for Spotify RSS, SMTP, Daraja, cards, Bible and optional media/push services.
# Enable outbound notifications deliberately after provider configuration and acceptance.
# Daraja callback: https://YOUR-ACTUAL-API-DOMAIN/api/v1/giving/mpesa/callback
# Card return: https://YOUR-ACTUAL-API-DOMAIN/api/v1/giving/card/return
